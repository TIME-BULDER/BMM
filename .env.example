# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de données PostgreSQL (Supabase)
# Utiliser la chaîne de connexion "pooler" pour les environnements serverless.
DATABASE_URL=postgresql://postgres:password@localhost:5432/bitcoin_blood

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé de service Supabase: usage serveur uniquement, ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mode démo (dev): ouvre l'espace app sans authentification avec des données simulées.
NEXT_PUBLIC_AUTH_BYPASS=false

# --- INNOVATIONS ZÉRO-FRAIS ---
# Clé privée Bitcoin de la clinique au format WIF (BIP-322 pour l'identité souveraine hors-ligne)
# Si non fournie, une clé éphémère est générée pour les tests
CLINIC_PRIVATE_KEY_WIF=L3xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé privée Nostr au format hexadécimal (pour la publication d'alertes d'urgence)
# Si non fournie, une clé éphémère est générée pour les tests
NOSTR_PRIVATE_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Izichange / Flash (Mobile Money)
IZICHANGE_API_KEY=your-izichange-api-key
IZICHANGE_API_URL=https://api.izichange.com/v1

